# AI tool local configs (do not commit)
AGENTS.local.md
.qoder/settings.local.json
.qoder/sessions/
.opencode/

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/

# Simulation outputs (large, regenerable)
*.pdb
*.out
!research/**/*.out
*.xyz
!research/**/*.xyz
!formose/**/*.xyz
!molecules/**/*.xyz

# Slurm logs (all jobs must write here; keep .gitkeep)
logs/slurm/*
!logs/slurm/.gitkeep
slurm-*.out
slurm-*.err

# Misc
.pytest_cache/
*.bak

# Formose run outputs (regenerable)
formose/runs/

# Microkinetics run outputs (regenerable)
formose/microkinetics/runs/

# Tuning scan outputs (regenerable)
formose/tune/

# Scratch work scripts / slurm logs
work_*.py
work_*.slurm
tune-*.out
tune-*.err
